# LeadNest configuration placeholders. Copy to .env and fill in real values locally.
# Never commit a populated .env file.

# --- Server ---
APP_ENV=development
SERVER_ADDR=:8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=leadnest
DB_USER=leadnest
DB_PASSWORD=leadnest
DB_SSLMODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=5m

# Optional: a full connection URI that overrides every DB_* value above.
# Use it for hosted databases such as Neon, which hand out a single URI.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Object storage (S3-compatible) ---
# Generate a credential to fill in the key ID + secret.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
# Bucket that objects are written to.
S3_BUCKET=
# Custom S3 endpoints usually require path-style bucket addressing.
S3_FORCE_PATH_STYLE=true

# --- Redis (optional, for rate limiting + token revocation cache) ---
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Auth ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Password policy ---
PASSWORD_MIN_LENGTH=8

# --- AI / LLM (optional; the API stays usable when these are empty) ---
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=15000
AI_MAX_TOKENS=2048

# --- Rate limiting ---
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000