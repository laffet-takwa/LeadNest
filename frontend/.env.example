# LeadNest frontend configuration.
#
# Only the API base URL belongs here. Never put a secret in a VITE_ variable:
# everything prefixed with VITE_ is bundled into the browser and is public.

# Base URL of the LeadNest API. The value must include the /api/v1 prefix.
VITE_API_BASE_URL=/api/v1

# Optional: absolute origin of the backend, used by the dev-server proxy and
# by the Playwright end-to-end suite.
VITE_DEV_API_PROXY=http://localhost:8080
